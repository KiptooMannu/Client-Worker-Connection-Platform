{
  "info": {
    "name": "Kazi Konnect - API",
    "_postman_id": "kazi-konnect-collection",
    "description": "Postman collection with auth, jobs, payments, and webhook endpoints (local testing).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"test_user\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CLIENT\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register" }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login" }
      }
    },
    {
      "name": "Jobs - Create Job Request",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Test job\",\n  \"location\": \"Nairobi\",\n  \"scheduledDate\": \"2026-06-01T10:00:00\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/jobs/request?clientId={{client_id}}&workerUserId={{worker_user_id}}" }
      }
    },
    {
      "name": "Payments - Initiate STK Push",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/payments/mpesa/stkpush?jobId={{job_id}}&phoneNumber={{phone_number}}" }
      }
    },
    {
      "name": "Payments - Get Status",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/payments/status/{{job_id}}" }
      }
    },
    {
      "name": "Payments - MPESA Callback (Webhook)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"12345\",\n      \"CheckoutRequestID\": \"TEST-CHECKOUT-1\",\n      \"ResultCode\": 0,\n      \"ResultDesc\": \"The service request is processed successfully.\",\n      \"CallbackMetadata\": {\n        \"Item\": [\n          { \"Name\": \"Amount\", \"Value\": 1500 },\n          { \"Name\": \"MpesaReceiptNumber\", \"Value\": \"ABC123XYZ\" },\n          { \"Name\": \"PhoneNumber\", \"Value\": \"254700000000\" }\n        ]\n      }\n    }\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/payments/mpesa/callback" }
      }
    },
    {
      "name": "Payments - Release Escrow",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/payments/escrow/release?jobId={{job_id}}" }
      }
    },
    {
      "name": "Payments - Refund Escrow",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/payments/escrow/refund?jobId={{job_id}}" }
      }
    },
    {
      "name": "Admin - Approve Worker",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/api/admin/workers/{{worker_id}}/approve?adminId={{admin_user_id}}" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "client_id", "value": "" },
    { "key": "worker_profile_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "job_id_param", "value": "" },
    { "key": "phone_number", "value": "254700000000" }
  ]
}
