{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "Web-App": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css", "src/landing.css", "src/material-theme.scss"],
            "allowedCommonJsDependencies": ["sockjs-client"],
            "outputMode": "static",
            "security": {
              "allowedHosts": []
              
            }
          },
            "configurations": {
              "production": {
                "optimization": {
                  "scripts": true,
                  "styles": {
                    "minify": true,
                    "inlineCritical": false
                  },
                  "fonts": {
                    "inline": false
                  }
                },
                "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500KB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "20kB"
                },
                {
                  "type": "all",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "namedChunks": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Web-App:build:production"
            },
            "development": {
              "buildTarget": "Web-App:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
