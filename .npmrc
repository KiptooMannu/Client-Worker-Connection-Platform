# @swimlane/ngx-charts@24 still declares a peer dependency on
# @angular/platform-browser-dynamic ("19.x || 20.x || 21.x"). npm resolves that
# to 20.0.7, which pins peer @angular/core@20.0.7 and so conflicts with this
# project's Angular 21 — a fresh `npm install` fails with ERESOLVE even though
# nothing here imports platform-browser-dynamic (it is a leftover from the
# pre-standalone bootstrap API).
#
# Installing with legacy peer resolution keeps CI and Vercel deploys working.
# Revisit once ngx-charts drops that peer.
legacy-peer-deps=true
